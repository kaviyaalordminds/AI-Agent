# Production / public deployment mode. Set these as real environment
# variables or secrets in your hosting platform — never as a committed
# .env file. Every value left blank below MUST be provided before
# deploying; the backend will refuse insecure defaults where it can
# (e.g. EMAIL_PROVIDER=console is rejected outside development/testing)
# but cannot invent real credentials for you.

APP_ENV=production
DEBUG=false
FRONTEND_URL=https://your-domain.example
BACKEND_URL=https://api.your-domain.example

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_COOKIE_SECURE=true

AI_RUNTIME_MODE=production
# Pick one real provider — the application code never changes, only this
# configuration. Set the matching credential below.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Or, instead of Anthropic:
# AI_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Image and video generation are real, API-based Gemini providers
# (Imagen/Veo) — no local/GPU model is ever used. Required for
# IMAGE_PROVIDER/VIDEO_PROVIDER=cloud below. Falls back to GOOGLE_API_KEY
# above if left blank.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# IMAGE_PROVIDER/VIDEO_PROVIDER=cloud use the real Gemini providers above.
# TTS/TRANSCRIPTION/VOICE "cloud" remain configuration points for a
# future vendor integration — they honestly report "not configured"
# until real credentials/vendor code are added.
TTS_PROVIDER=cloud
TRANSCRIPTION_PROVIDER=cloud
IMAGE_PROVIDER=cloud
VIDEO_PROVIDER=cloud
VOICE_PROVIDER=cloud

# KNOWLEDGE_PROVIDER stays "obsidian" — each user still gets their own
# isolated vault (never the operator's personal vault). Point the root
# at a real per-user-synced location for your deployment.
KNOWLEDGE_PROVIDER=obsidian
OBSIDIAN_PROVIDER=local_vault
OBSIDIAN_VAULT_ROOT=/var/lib/ai-agent/obsidian_vaults

# STORAGE_PROVIDER stays "local" until an S3-compatible provider
# implementation is added — StorageProvider is architected so swapping
# it later touches no call sites.
STORAGE_PROVIDER=local
STORAGE_ROOT=/var/lib/ai-agent/storage
MAX_UPLOAD_FILE_SIZE_MB=25

DEPLOYMENT_PROVIDER=local
# DEPLOYMENT_PROVIDER=netlify
NETLIFY_API_TOKEN=
# DEPLOYMENT_PROVIDER=vercel
VERCEL_API_TOKEN=

# JOB_QUEUE stays "in_process" until a Celery/RQ-backed implementation is
# added — see app/jobs/queue.py. Size the local worker pool to your
# instance's CPU/memory budget.
JOB_QUEUE=in_process
JOB_QUEUE_MAX_WORKERS=4
GENERATION_RATE_LIMIT_MAX_REQUESTS=20
GENERATION_RATE_LIMIT_WINDOW_MINUTES=15
GENERATION_MAX_CONCURRENT_JOBS_PER_USER=3
GENERATION_MAX_JOB_DURATION_SECONDS=600

# console is refused when APP_ENV=production — configure real SMTP (or a
# transactional email API behind a future EmailProvider implementation).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@your-domain.example
EMAIL_FROM_NAME=AI Agent Platform
