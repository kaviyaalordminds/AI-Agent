# Local development / testing mode. Copy to .env and adjust as needed.
# The backend starts fine with zero cloud API keys — every non-AI feature
# (auth, projects, history, Obsidian, Documents storage, jobs, system
# status) works normally. AI Chat/Knowledge Gaps/Documents just honestly
# report "not configured" until you set ANTHROPIC_API_KEY below. There is
# no local/Ollama LLM option — Claude via the Anthropic API is the AI
# chat/reasoning provider in every mode.

APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@127.0.0.1:5432/ai_agent_dev

SECRET_KEY=dev-insecure-secret-change-me
SESSION_COOKIE_SECURE=false

AI_RUNTIME_MODE=local
AI_PROVIDER=anthropic

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional: set AI_PROVIDER=gemini above and fill this in to use Gemini
# for chat/reasoning instead of Claude.
GOOGLE_API_KEY=

# Image and video generation are API-based only (Gemini Imagen/Veo) —
# there is no local/GPU model. Set GEMINI_API_KEY (falls back to
# GOOGLE_API_KEY above if left blank) to enable them; without a key they
# honestly report "not configured" rather than crashing.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

TTS_PROVIDER=local
TRANSCRIPTION_PROVIDER=local
# IMAGE_PROVIDER / VIDEO_PROVIDER select a MODE, not a credential — the
# ONLY valid values are the literal words "local" or "cloud". Do NOT put
# an API key here; the backend will refuse to start with a Pydantic
# validation error ("Input should be 'local' or 'cloud'") if you do. Put
# the actual Gemini API key in GEMINI_API_KEY above instead.
IMAGE_PROVIDER=cloud
VIDEO_PROVIDER=cloud
VOICE_PROVIDER=local

KNOWLEDGE_PROVIDER=obsidian
OBSIDIAN_PROVIDER=local_vault
OBSIDIAN_VAULT_ROOT=../storage/obsidian_vaults

STORAGE_PROVIDER=local
STORAGE_ROOT=../storage

DEPLOYMENT_PROVIDER=local

JOB_QUEUE=in_process
JOB_QUEUE_MAX_WORKERS=4

EMAIL_PROVIDER=console
