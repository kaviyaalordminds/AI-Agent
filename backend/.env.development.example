# Local development / testing mode. Copy to .env and adjust as needed.
# Works fully with zero cloud API keys — Ollama is optional too; if it
# isn't installed/running, the backend still starts and every non-AI
# feature (auth, projects, history, Obsidian, Documents storage, jobs,
# system status) works normally. AI Chat/Knowledge Gaps/Documents just
# honestly report "not configured" until you either install Ollama or
# set a cloud API key below.

APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@localhost:5432/ai_agent_dev

SECRET_KEY=dev-insecure-secret-change-me
SESSION_COOKIE_SECURE=false

AI_RUNTIME_MODE=local
AI_PROVIDER=ollama

# Install Ollama (https://ollama.com), run `ollama serve`, then
# `ollama pull llama3.1` (or any model you prefer) and set it here.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional: skip Ollama and use a real cloud key instead, even in local
# mode — set AI_PROVIDER=anthropic (or gemini) above and fill in the
# matching key below.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

TTS_PROVIDER=local
TRANSCRIPTION_PROVIDER=local
IMAGE_PROVIDER=local
VIDEO_PROVIDER=local
VOICE_PROVIDER=local

KNOWLEDGE_PROVIDER=obsidian
OBSIDIAN_PROVIDER=local_vault
OBSIDIAN_VAULT_ROOT=../storage/obsidian_vaults

STORAGE_PROVIDER=local
STORAGE_ROOT=../storage

DEPLOYMENT_PROVIDER=local

JOB_QUEUE=in_process
JOB_QUEUE_MAX_WORKERS=4

EMAIL_PROVIDER=console
