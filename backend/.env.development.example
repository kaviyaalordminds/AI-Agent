# Local development / testing mode. Copy to .env and adjust as needed.
# The backend starts fine with zero cloud API keys — every non-AI feature
# (auth, projects, history, Obsidian, Documents storage, jobs, system
# status) works normally. AI Chat/Knowledge Gaps/Documents just honestly
# report "not configured" until you set ANTHROPIC_API_KEY below. There is
# no local/Ollama LLM option — Claude via the Anthropic API is the AI
# chat/reasoning provider in every mode.

APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@127.0.0.1:5432/ai_agent_dev

SECRET_KEY=dev-insecure-secret-change-me
SESSION_COOKIE_SECURE=false

AI_RUNTIME_MODE=local
AI_PROVIDER=anthropic

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional: set AI_PROVIDER=gemini above and fill this in to use Gemini
# for chat/reasoning instead of Claude.
GOOGLE_API_KEY=

# Video generation is API-based only (Gemini Veo) — there is no local/GPU
# model. Set GEMINI_API_KEY (falls back to GOOGLE_API_KEY above if left
# blank) to enable it; without a key it honestly reports "not configured"
# rather than crashing.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# Image generation is API-based only (OpenAI) — there is no local/GPU
# model. Set OPENAI_API_KEY to enable it; without a key it honestly
# reports "not configured" rather than crashing. Separate credential from
# ANTHROPIC_API_KEY/GEMINI_API_KEY above. If gpt-image-1 isn't available
# on your account (some require org verification), override with
# whichever model GET https://api.openai.com/v1/models shows as
# available on your key, e.g. OPENAI_IMAGE_MODEL=dall-e-2.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

TTS_PROVIDER=local
TRANSCRIPTION_PROVIDER=local
# IMAGE_PROVIDER / VIDEO_PROVIDER / TTS_PROVIDER / TRANSCRIPTION_PROVIDER /
# VOICE_PROVIDER select a MODE, not a credential — the ONLY valid values
# are the literal words "local" or "cloud". Do NOT put an API key here;
# the backend will refuse to start with a Pydantic validation error
# ("Input should be 'local' or 'cloud'") if you do. Put the actual
# credential in OPENAI_API_KEY / GEMINI_API_KEY / ELEVENLABS_API_KEY
# instead.
IMAGE_PROVIDER=cloud
VIDEO_PROVIDER=cloud
VOICE_PROVIDER=local

# Reuses OPENAI_API_KEY above — only used when TTS_PROVIDER=cloud /
# TRANSCRIPTION_PROVIDER=cloud.
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# A separate credential from OpenAI — only used when VOICE_PROVIDER=cloud.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MODEL=eleven_multilingual_v2

# IMPORTANT: the Obsidian Vault is NEVER the same thing as STORAGE_ROOT
# below. STORAGE_ROOT holds AI-Agent-generated assets; the Obsidian Vault
# holds your actual Markdown knowledge notes. Default (OBSIDIAN_VAULT_PATH
# left unset) gives each user their own isolated vault under
# OBSIDIAN_VAULT_ROOT/<user_id>/ — fine for multi-user testing, but if
# you're running this for yourself against a real, already-existing
# Obsidian vault, uncomment OBSIDIAN_VAULT_PATH below instead: it always
# wins over OBSIDIAN_VAULT_ROOT and resolves to that EXACT directory, no
# per-user subfolder appended.
KNOWLEDGE_PROVIDER=obsidian
OBSIDIAN_PROVIDER=local_vault
OBSIDIAN_VAULT_ROOT=../storage/obsidian_vaults
# Direct path to your existing local Obsidian Vault. This is NOT the AI
# Agent storage directory — AI Agent generated files use STORAGE_ROOT
# below, completely separately.
# OBSIDIAN_VAULT_PATH=C:\Users\you\Documents\Obsidian Vault

STORAGE_PROVIDER=local
STORAGE_ROOT=../storage

DEPLOYMENT_PROVIDER=local

JOB_QUEUE=in_process
JOB_QUEUE_MAX_WORKERS=4

EMAIL_PROVIDER=console
