# Copy this file to .env for local development. In staging/production,
# set these as real environment variables / secrets — never commit a
# populated .env file.

# --- Core ---
APP_ENV=development            # development | testing | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@localhost:5432/ai_agent_dev

# --- Security / Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
SESSION_COOKIE_SECURE=false    # MUST be true in staging/production (HTTPS only)

# --- Claude provider ---
# Leave ANTHROPIC_API_KEY empty for local development without a real key —
# the backend starts fine and every non-Claude feature works normally;
# AI Chat, Knowledge Gaps, and Documents honestly report "not configured"
# instead of faking a response. Set it to enable real generation.
CLAUDE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_OUTPUT_TOKENS=4096

# --- Storage provider (generated documents/images/video/audio) ---
STORAGE_PROVIDER=local
STORAGE_ROOT=../storage

# --- Obsidian provider ---
OBSIDIAN_PROVIDER=local_vault
OBSIDIAN_VAULT_ROOT=../storage/obsidian_vaults

# --- Email provider ---
# console: logs emails instead of sending (development only; refused in
#          staging/production at startup).
# smtp:    sends via the SMTP_* settings below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@ai-agent.dev
EMAIL_FROM_NAME=AI Agent Platform

# --- Future phases (provider-abstraction architecture; not yet consumed) ---
