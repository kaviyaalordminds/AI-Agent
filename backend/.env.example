# Copy this file to .env for local development. In staging/production,
# set these as real environment variables / secrets — never commit a
# populated .env file. See .env.development.example and
# .env.production.example for two ready-to-use starting points.

# --- Core ---
APP_ENV=development            # development | testing | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@127.0.0.1:5432/ai_agent_dev

# --- Security / Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
SESSION_COOKIE_SECURE=false    # MUST be true in staging/production (HTTPS only)

# --- AI runtime mode ---
# Governs local-vs-cloud defaults for OTHER provider families (audio/
# transcription/image/video/voice — see their own *_PROVIDER settings
# below). Leave blank to auto-derive from APP_ENV (development/testing ->
# local, staging/production -> production). Does NOT affect which AI
# chat/reasoning provider is used — see AI_PROVIDER below.
AI_RUNTIME_MODE=
# AI chat/reasoning provider: anthropic | gemini. Leave blank to default
# to anthropic. There is no Ollama or other local-LLM option — Claude via
# the Anthropic API is always used for chat/reasoning unless this is set
# to "gemini". The backend never crashes and every non-AI feature keeps
# working regardless of whether the chosen provider is configured — AI
# Chat, Knowledge Gaps, and Documents honestly report "not configured"
# instead of faking a response.
AI_PROVIDER=

# --- Anthropic (Claude) provider — the default AI chat/reasoning provider ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_OUTPUT_TOKENS=4096

# --- Gemini provider (text chat) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Gemini video generation ---
# Video generation is API-based only — there is no local/GPU model.
# VIDEO_PROVIDER below already defaults to "cloud", so setting this key is
# the ONLY thing required to make video generation work. Falls back to
# GOOGLE_API_KEY above if GEMINI_API_KEY is left blank, so setting only
# one of the two keys is fine.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# --- OpenAI image generation ---
# Image generation is API-based only — there is no local/GPU model.
# IMAGE_PROVIDER below already defaults to "cloud", so setting this key is
# the ONLY thing required to make image generation work. This is a
# separate credential from ANTHROPIC_API_KEY/GEMINI_API_KEY above — chat
# and video generation do not use it. If your account/project doesn't
# have gpt-image-1 access (some require org verification), override this
# with whichever model GET https://api.openai.com/v1/models shows as
# available on your own key — e.g. OPENAI_IMAGE_MODEL=dall-e-2.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Storage provider (generated documents/images/video/audio) ---
STORAGE_PROVIDER=local
STORAGE_ROOT=../storage
MAX_UPLOAD_FILE_SIZE_MB=25

# --- Obsidian / Knowledge provider ---
# Default: each user gets their own isolated vault under
# {OBSIDIAN_VAULT_ROOT}/{user_id}/ — never one shared/global vault.
KNOWLEDGE_PROVIDER=obsidian
OBSIDIAN_PROVIDER=local_vault
OBSIDIAN_VAULT_ROOT=../storage/obsidian_vaults
# Optional, single-user/personal deployments only: point directly at a
# real, already-existing Obsidian vault instead of the per-user layout
# above. When set, every user on this backend shares this exact
# directory — do not set it on a backend with more than one real user.
# Existing folders/notes are never overwritten (provisioning only runs
# if this directory doesn't exist yet). Leave commented out to keep the
# default per-user isolation.
# OBSIDIAN_VAULT_PATH=C:\Users\you\Documents\Obsidian Vault

# --- Audio / Transcription / Image / Video / Voice providers ---
# local: real local backend if installed (e.g. espeak-ng for audio),
# otherwise honestly reports "unavailable" with setup instructions. Never
# requires a GPU or a multi-GB model download for anything in this app.
# cloud: a real vendor API (OpenAI for image, Gemini for video; a
# configuration point for future audio/transcription/voice vendor
# integrations).
TTS_PROVIDER=local
TRANSCRIPTION_PROVIDER=local
# IMAGE_PROVIDER / VIDEO_PROVIDER select a MODE, not a credential — the
# ONLY valid values are the literal words "local" or "cloud". Do NOT put
# an API key here; the backend will refuse to start with a Pydantic
# validation error ("Input should be 'local' or 'cloud'") if you do. Put
# the actual credential in OPENAI_API_KEY (image) / GEMINI_API_KEY (video)
# above instead.
IMAGE_PROVIDER=cloud
VIDEO_PROVIDER=cloud
VOICE_PROVIDER=local

# --- Deployment provider ---
DEPLOYMENT_PROVIDER=local
NETLIFY_API_TOKEN=
VERCEL_API_TOKEN=

# --- Generation jobs / job queue ---
JOB_QUEUE=in_process
JOB_QUEUE_MAX_WORKERS=4
GENERATION_RATE_LIMIT_MAX_REQUESTS=20
GENERATION_RATE_LIMIT_WINDOW_MINUTES=15
GENERATION_MAX_CONCURRENT_JOBS_PER_USER=3
GENERATION_MAX_JOB_DURATION_SECONDS=600

# --- Email provider ---
# console: logs emails instead of sending (development only; refused in
#          staging/production at startup).
# smtp:    sends via the SMTP_* settings below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@ai-agent.dev
EMAIL_FROM_NAME=AI Agent Platform
