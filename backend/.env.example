# Copy this file to .env for local development. In staging/production,
# set these as real environment variables / secrets — never commit a
# populated .env file. See .env.development.example and
# .env.production.example for two ready-to-use starting points.

# --- Core ---
APP_ENV=development            # development | testing | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@localhost:5432/ai_agent_dev

# --- Security / Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
SESSION_COOKIE_SECURE=false    # MUST be true in staging/production (HTTPS only)

# --- AI runtime mode ---
# local: prefers Ollama (no cloud API key required). production: prefers a
# configured cloud provider. Leave blank to auto-derive from APP_ENV
# (development/testing -> local, staging/production -> production).
AI_RUNTIME_MODE=
# Explicit provider override: ollama | anthropic | gemini. Leave blank to
# use the AI_RUNTIME_MODE default (ollama for local, anthropic for
# production). The backend never crashes and every non-AI feature keeps
# working regardless of whether the chosen provider is configured — AI
# Chat, Knowledge Gaps, and Documents honestly report "not configured"
# instead of faking a response.
AI_PROVIDER=

# --- Ollama provider (local mode default; no API key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Anthropic (Claude) provider ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_OUTPUT_TOKENS=4096

# --- Gemini provider (text chat) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Gemini media generation (image/video) ---
# Set IMAGE_PROVIDER=cloud and/or VIDEO_PROVIDER=cloud below to use these.
# Falls back to GOOGLE_API_KEY above if GEMINI_API_KEY is left blank, so
# setting only one of the two keys is fine.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# --- Storage provider (generated documents/images/video/audio) ---
STORAGE_PROVIDER=local
STORAGE_ROOT=../storage
MAX_UPLOAD_FILE_SIZE_MB=25

# --- Obsidian / Knowledge provider ---
# Each user gets their own isolated vault — never one shared/global vault.
KNOWLEDGE_PROVIDER=obsidian
OBSIDIAN_PROVIDER=local_vault
OBSIDIAN_VAULT_ROOT=../storage/obsidian_vaults

# --- Audio / Transcription / Image / Video / Voice providers ---
# local: real local backend if installed (e.g. espeak-ng for audio),
# otherwise honestly reports "unavailable" with setup instructions.
# cloud: architecture point for a future vendor integration.
TTS_PROVIDER=local
TRANSCRIPTION_PROVIDER=local
IMAGE_PROVIDER=local
VIDEO_PROVIDER=local
VOICE_PROVIDER=local

# --- Deployment provider ---
DEPLOYMENT_PROVIDER=local
NETLIFY_API_TOKEN=
VERCEL_API_TOKEN=

# --- Generation jobs / job queue ---
JOB_QUEUE=in_process
JOB_QUEUE_MAX_WORKERS=4
GENERATION_RATE_LIMIT_MAX_REQUESTS=20
GENERATION_RATE_LIMIT_WINDOW_MINUTES=15
GENERATION_MAX_CONCURRENT_JOBS_PER_USER=3
GENERATION_MAX_JOB_DURATION_SECONDS=600

# --- Email provider ---
# console: logs emails instead of sending (development only; refused in
#          staging/production at startup).
# smtp:    sends via the SMTP_* settings below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@ai-agent.dev
EMAIL_FROM_NAME=AI Agent Platform
